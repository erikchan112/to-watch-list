# Copy to .env and fill in.

# Password that protects your list (you type it once on your phone; it stays signed in for a year).
APP_PASSWORD=
# Optional: separate secret for signing the login cookie. Defaults to APP_PASSWORD.
SESSION_SECRET=

# Claude reads the shared post and works out which title it is about.
# Create a key at https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# TMDB gives posters, year, genre and runtime, and powers title search.
# Free: https://www.themoviedb.org/settings/api  (either the API key or the Read Access Token works)
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# Where the list is stored (a JSON file). Point this at a persistent disk in production.
DATA_FILE=./data/watchlist.json
PORT=3000
